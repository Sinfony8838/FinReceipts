{"uid":"finreceipts-v2","title":"FinReceipts execution and budget","schemaVersion":39,"version":1,"refresh":"5s","time":{"from":"now-30m","to":"now"},"panels":[{"id":1,"type":"timeseries","title":"Queued / running / unknown tasks","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"max(finreceipts_queued_tasks)","legendFormat":"queued"},{"expr":"max(finreceipts_running_tasks)","legendFormat":"running"},{"expr":"max(finreceipts_unknown_tasks)","legendFormat":"unknown"}]},{"id":2,"type":"timeseries","title":"Conservative CNY ledger","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"max(finreceipts_spent_micros)/1000000","legendFormat":"settled estimate"},{"expr":"max(finreceipts_reserved_micros)/1000000","legendFormat":"reserved / unresolved"}]},{"id":3,"type":"timeseries","title":"Oldest queued task (seconds)","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"max(finreceipts_oldest_queue_seconds)"}]},{"id":4,"type":"timeseries","title":"Dispatch failures / lease expiry","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"sum(rate(finreceipts_dispatch_failures_total[5m]))","legendFormat":"dispatch failure"},{"expr":"sum(rate(finreceipts_lease_expirations_total[5m]))","legendFormat":"lease expiry"}]},{"id":5,"type":"stat","title":"Metrics freshness (seconds)","gridPos":{"x":0,"y":16,"w":8,"h":4},"targets":[{"expr":"time()-max(finreceipts_snapshot_epoch_seconds)"}]}]}
