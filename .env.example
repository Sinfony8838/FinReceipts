# Copy to .env (git-ignored). Never commit real keys.
# SEC asks for a descriptive User-Agent with a real contact address.
FINRECEIPTS_SEC_USER_AGENT="FinReceipts research bot contact@example.com"
# LLM provider: "anthropic" (Anthropic-compatible) or "openai" (OpenAI-compatible) or "fake".
FINRECEIPTS_LLM_PROVIDER=fake
FINRECEIPTS_LLM_BASE_URL=
# Name of the environment variable that holds the API key (the key itself is never read from files).
FINRECEIPTS_LLM_API_KEY_ENV=
FINRECEIPTS_SMALL_MODEL=
FINRECEIPTS_LARGE_MODEL=
# Example: MiniMax official API (mainland platform), Anthropic-compatible. The key is read from
# the env var *named* below; put the key itself only in your shell env, never in this file.
#   FINRECEIPTS_LLM_PROVIDER=anthropic
#   FINRECEIPTS_LLM_BASE_URL=https://api.minimaxi.com/anthropic   # international keys: https://api.minimax.io/anthropic
#   FINRECEIPTS_LLM_API_KEY_ENV=MINIMAX_API_KEY
#   FINRECEIPTS_SMALL_MODEL=MiniMax-M3            # thinking off (M3 default)
#   FINRECEIPTS_LARGE_MODEL=MiniMax-M3+think      # "+think" = same model with thinking enabled
# Pacing between sequential LLM calls (seconds):
# FINRECEIPTS_MIN_CALL_INTERVAL_S=1.0
# Volcengine Ark Coding Plan URLs (.../api/coding) are refused by default: their terms limit
# the quota to AI coding tools (docs/llm_access.md). Only set this after confirming permission.
# FINRECEIPTS_ALLOW_CODING_PLAN=1
# Demo API (finreceipts-api / docker compose):
# FINRECEIPTS_HOST=0.0.0.0
# FINRECEIPTS_PORT=8000
